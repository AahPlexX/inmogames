{
  "name": "inmogames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "game:check": "node scripts/game-check.mjs",
    "test:unit": "vitest run",
    "build": "vite build",
    "build:firebase": "vite build --base=/",
    "validate": "pnpm dependency:check && pnpm typecheck && pnpm game:check && pnpm test:unit && pnpm build",
    "dependency:check": "node scripts/dependency-check.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
