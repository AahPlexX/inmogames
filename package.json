{
  "name": "inmogames",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "game:check": "node scripts/game-check.mjs",
    "test:unit": "vitest run",
    "build": "vite build",
    "build:firebase": "vite build --base=/",
    "validate": "pnpm dependency:check && pnpm dependency:current && pnpm design:check && pnpm typecheck && pnpm game:check && pnpm test:unit && pnpm test:rules && pnpm test:browser && pnpm test:design-browser && pnpm build:firebase && pnpm build",
    "dependency:check": "node scripts/dependency-check.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-inmogames \"node --test tests/rules/firestore.test.mjs\"",
    "test:browser": "firebase emulators:exec --only auth,firestore --project demo-inmogames \"node tests/browser/account-persistence.mjs\"",
    "test:design-browser": "node tests/browser/design-regression.mjs",
    "dependency:current": "node scripts/verify-dependency-latest.mjs",
    "design:check": "pnpm dlx @google/design.md@0.4.0 lint DESIGN.md"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.32.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
