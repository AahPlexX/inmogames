rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/games/{gameId} {
      function ownsSave() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validEnvelope() {
        return gameId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          && request.resource.data.keys().hasAll(['schemaVersion', 'state', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'state', 'updatedAt'])
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 1
          && request.resource.data.state is map
          && request.resource.data.updatedAt == request.time;
      }
      allow read, delete: if ownsSave();
      allow create, update: if ownsSave() && validEnvelope();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
